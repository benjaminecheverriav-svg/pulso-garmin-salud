# Copia este archivo como .env (en la misma carpeta) y completa lo que quieras usar.

# Opcional: inicio de sesión automático en Garmin (también puedes conectar desde la app).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Opcional: activa el entrenador conversacional con IA (Claude).
# Crea tu clave en https://console.anthropic.com > API Keys. Tiene un coste por uso.
ANTHROPIC_API_KEY=
